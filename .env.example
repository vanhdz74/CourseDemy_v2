# Docker Compose defaults for local development on Windows, macOS, and Linux.

BACKEND_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5434

FRONTEND_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
BACKEND_INTERNAL_URL=http://backend:8080

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/coursedemy_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=coursedemy_db

MAIL_USERNAME=
MAIL_PASSWORD=

# Must be standard Base64 and decode to at least 32 bytes for HS256.
# Generate one with: openssl rand -base64 32
JWT_SECRET=ZGV2LW9ubHktY291cnNlZGVteS1qd3Qtc2VjcmV0LTEyMzQ1Ng==
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Generate a new value for real use.
AUTH_SECRET=dev-only-change-me
