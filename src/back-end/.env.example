FRONTEND_URL=http://localhost:3000

# Optional when running only one service. Do not set this globally when running
# multiple services because each service already has its own default port.
# SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

GATEWAY_SERVICE_DB_NAME=gateway_service_db
USER_SERVICE_DB_NAME=user_service_db
COURSE_SERVICE_DB_NAME=course_service_db
ORDER_SERVICE_DB_NAME=order_service_db
PAYMENT_SERVICE_DB_NAME=payment_service_db
ENROLLMENT_SERVICE_DB_NAME=enrollment_service_db
NOTIFICATION_SERVICE_DB_NAME=notification_service_db

REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

JPA_SHOW_SQL=true
JPA_DDL_AUTO=update

MAIL_USERNAME=
MAIL_PASSWORD=

# Must be standard Base64 and decode to at least 32 bytes for HS256.
# Generate one with: openssl rand -base64 32
JWT_SECRET=ZGV2LW9ubHktY291cnNlZGVteS1qd3Qtc2VjcmV0LTEyMzQ1Ng==
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=2592000000

# Optional VNPAY sandbox/payment config.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/payment/vnpay/return
