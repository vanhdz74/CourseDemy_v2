# =============================================================================
# COURSEDEMY BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# =============================================================================

# =============================================================================
# [PHƯƠNG ÁN 1] SUPABASE CLOUD POSTGRESQL (Dùng khi kết nối Cloud Supabase)
# =============================================================================
# Hướng dẫn:
# 1. Điền thông tin kết nối từ Supabase Dashboard (Database -> Connection Pooling / Direct Connection).
# 2. Sử dụng cổng 6543 (Session/Transaction Pooler) hoặc cổng 5432 (Direct Connection).
# 3. Để bật Supabase, bỏ comment các dòng dưới đây và điền thông tin tương ứng.

# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.YOUR_SUPABASE_PROJECT_REF
# DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
# DB_SSLMODE=require

# (Tùy chọn) Gán trực tiếp URL Datasource riêng cho từng service nếu dùng Database riêng biệt trên Cloud:
# GATEWAY_SERVICE_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&currentSchema=auth_service_db
# USER_SERVICE_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&currentSchema=user_service_db
# COURSE_SERVICE_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&currentSchema=course_service_db
# ORDER_SERVICE_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&currentSchema=order_service_db
# PAYMENT_SERVICE_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&currentSchema=payment_service_db
# ENROLLMENT_SERVICE_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&currentSchema=enrollment_service_db
# NOTIFICATION_SERVICE_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&currentSchema=notification_service_db


# =============================================================================
# [PHƯƠNG ÁN 2] POSTGRESQL LOCAL / REMOTE HOST CHO KIẾN TRÚC MICROSERVICES
# =============================================================================
# Hướng dẫn:
# 1. Trỏ trực tiếp đến máy chủ PostgreSQL trên máy tính (localhost), trong mạng LAN (ví dụ: 192.168.1.100),
#    hoặc qua Docker network / Host riêng biệt.
# 2. Mỗi service sử dụng 1 Schema riêng (auth_service_db, user_service_db, course_service_db...)
#    hoặc có thể trỏ tới từng Database riêng biệt trên các host khác nhau.

# Cấu hình chung cho PostgreSQL (Local hoặc Remote Host):
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Tên schema phân chia theo từng microservice:
GATEWAY_SERVICE_DB_NAME=auth_service_db
USER_SERVICE_DB_NAME=user_service_db
COURSE_SERVICE_DB_NAME=course_service_db
ORDER_SERVICE_DB_NAME=order_service_db
PAYMENT_SERVICE_DB_NAME=payment_service_db
ENROLLMENT_SERVICE_DB_NAME=enrollment_service_db
NOTIFICATION_SERVICE_DB_NAME=notification_service_db

# (Nâng cao) Nếu mỗi microservice đặt tại một máy chủ / Database Host RIÊNG BIỆT (Multi-host Microservices):
# GATEWAY_SERVICE_DATASOURCE_URL=jdbc:postgresql://192.168.1.101:5432/gateway_db?sslmode=disable
# USER_SERVICE_DATASOURCE_URL=jdbc:postgresql://192.168.1.102:5432/user_db?sslmode=disable
# COURSE_SERVICE_DATASOURCE_URL=jdbc:postgresql://192.168.1.103:5432/course_db?sslmode=disable
# ORDER_SERVICE_DATASOURCE_URL=jdbc:postgresql://192.168.1.104:5432/order_db?sslmode=disable
# PAYMENT_SERVICE_DATASOURCE_URL=jdbc:postgresql://192.168.1.105:5432/payment_db?sslmode=disable
# ENROLLMENT_SERVICE_DATASOURCE_URL=jdbc:postgresql://192.168.1.106:5432/enrollment_db?sslmode=disable
# NOTIFICATION_SERVICE_DATASOURCE_URL=jdbc:postgresql://192.168.1.107:5432/notification_db?sslmode=disable


# =============================================================================
# REDIS CACHE
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=


# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=600000
JWT_REFRESH_EXPIRATION=2592000000


# =============================================================================
# SPRING EUREKA DISCOVERY & SERVICE PORTS
# =============================================================================
EUREKA_CLIENT_SERVICE_URL_DEFAULTZONE=http://localhost:8761/eureka
FRONTEND_URL=http://localhost:3000


# =============================================================================
# EMAIL (GMAIL SMTP)
# =============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password


# =============================================================================
# THIRD-PARTY SERVICES (Cloudinary, VNPay)
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8086/api/payment/vnpay/return
