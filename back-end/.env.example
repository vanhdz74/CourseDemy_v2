PORT=8080
FRONTEND_URL=http://localhost:3000

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/coursedemy_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

MAIL_USERNAME=
MAIL_PASSWORD=

# Must be standard Base64 and decode to at least 32 bytes for HS256.
# Generate one with: openssl rand -base64 32
JWT_SECRET=ZGV2LW9ubHktY291cnNlZGVteS1qd3Qtc2VjcmV0LTEyMzQ1Ng==
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=2592000000

# Optional VNPAY sandbox/payment config.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/payment/vnpay/return

# Optional seed admin account for local development.
SEED_ADMIN_EMAIL=admin@coursedemy.local
SEED_ADMIN_PASSWORD=change-me
