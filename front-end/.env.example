# Copy this file to .env.local for local frontend development.

NEXT_PUBLIC_API_URL=http://localhost:8080
BACKEND_INTERNAL_URL=http://localhost:8080

AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
